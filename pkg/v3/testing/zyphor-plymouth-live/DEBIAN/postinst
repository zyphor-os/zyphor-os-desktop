#!/bin/sh
set -e

THEME_DIR="/usr/share/plymouth/themes/zyphor"

# Set ownership and permissions
if [ -d "$THEME_DIR" ]; then
    chown -R root:root "$THEME_DIR"

    find "$THEME_DIR" -type d -exec chmod 755 {} \;
    find "$THEME_DIR" -type f -exec chmod 644 {} \;
fi

# Set Zyphor as the default Plymouth theme
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme zyphor
fi

# Configure GRUB command line if available
if [ -f /etc/default/grub ]; then
    sed -i \
        's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/' \
        /etc/default/grub
fi

# Do NOT run update-grub here.
# Live ISO builds use an overlay filesystem, which causes
# grub-probe to fail with:
# "failed to get canonical path of 'overlay'"

# Rebuild initramfs
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u -k all
fi

exit 0