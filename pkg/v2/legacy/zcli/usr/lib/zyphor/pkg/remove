#!/bin/bash

zyphor_pkg_remove() {

  APP="$3"
  PREFERRED_MGR="$4"   # optional: apt | snap | flatpak (used only for unregistered apps)

  # ==================================================
  # SAFE DEFAULTS (prevents curl issues)
  # ==================================================
  REGISTRY_URL="${REGISTRY_URL:-https://zyphor-os.github.io/ada-lovelace-lts/registry/registry.json}"
  CACHE_FILE="${CACHE_FILE:-/tmp/zyphor_registry.json}"

  # ==================================================
  # VALIDATE INPUT
  # ==================================================
  if [ -z "$APP" ]; then
    echo ""
    echo "Zyphor: ✖ Missing app name"
    echo "Usage: zyphor pkg remove <app> [apt|snap|flatpak]"
    echo ""
    return 1
  fi

  # ==================================================
  # ROOT CHECK
  # ==================================================
  if [ "$EUID" -ne 0 ]; then
    echo ""
    echo "Zyphor: ⚠ Requires root privileges"
    echo "Try: sudo zyphor pkg remove $APP"
    echo ""
    return 1
  fi

  # ==================================================
  # LOAD REGISTRY (WITH FALLBACK)
  # ==================================================
  echo ""
  echo "Zyphor: Loading registry..."

  if ! curl -fsSL "$REGISTRY_URL" -o "$CACHE_FILE"; then
    echo "Zyphor: ⚠ Failed writing to $CACHE_FILE"

    CACHE_FILE="/var/tmp/zyphor_registry.json"
    echo "Zyphor: Retrying → $CACHE_FILE"

    if ! curl -fsSL "$REGISTRY_URL" -o "$CACHE_FILE"; then
      echo "Zyphor: ⚠ Using cached registry..."

      if [ ! -f "$CACHE_FILE" ]; then
        echo "Zyphor: ✖ No registry available"
        return 1
      fi
    fi
  fi

  # ==================================================
  # RESOLVE APP
  # ==================================================
  TYPE=$(jq -r ".apps.\"$APP\".type // empty" "$CACHE_FILE")
  PACKAGE=$(jq -r ".apps.\"$APP\".package // empty" "$CACHE_FILE")
  MODULE=$(jq -r ".apps.\"$APP\".module // empty" "$CACHE_FILE")

  # ==================================================
  # UNREGISTERED APP → LIVE DETECTION FALLBACK
  # Looks for a currently-installed match via apt/snap/
  # flatpak so unregistered apps can still be removed.
  # ==================================================
  if [ -z "$TYPE" ] || [ "$TYPE" = "null" ]; then

    echo ""
    echo "Zyphor: ⚠ '$APP' is not registered in the app registry"
    echo "Zyphor: Checking installed packages directly..."
    echo ""

    APT_MATCH=""
    SNAP_MATCH=""
    FLATPAK_MATCH=""

    # ---- apt: prefer exact match, fall back to loose match ----
    if command -v dpkg >/dev/null 2>&1; then
      APT_MATCH=$(dpkg -l | awk '$1=="ii"{print $2}' | grep -ix "$APP" | head -n 1)
      if [ -z "$APT_MATCH" ]; then
        APT_MATCH=$(dpkg -l | awk '$1=="ii"{print $2}' | grep -i "$APP" | head -n 1)
      fi
    fi

    # ---- snap ----
    if command -v snap >/dev/null 2>&1; then
      SNAP_MATCH=$(snap list 2>/dev/null | awk '{print $1}' | grep -ix "$APP" | head -n 1)
    fi

    # ---- flatpak ----
    if command -v flatpak >/dev/null 2>&1; then
      FLATPAK_MATCH=$(flatpak list --app --columns=application 2>/dev/null | grep -ix "$APP" | head -n 1)
      if [ -z "$FLATPAK_MATCH" ]; then
        FLATPAK_MATCH=$(flatpak list --app --columns=application 2>/dev/null | grep -i "$APP" | head -n 1)
      fi
    fi

    # Build the list of managers that actually have a match
    FOUND_MGRS=()
    [ -n "$APT_MATCH" ]     && FOUND_MGRS+=("apt")
    [ -n "$SNAP_MATCH" ]    && FOUND_MGRS+=("snap")
    [ -n "$FLATPAK_MATCH" ] && FOUND_MGRS+=("flatpak")

    if [ "${#FOUND_MGRS[@]}" -eq 0 ]; then
      echo "Zyphor: ✖ '$APP' is not installed via apt, snap, or flatpak"
      echo ""
      return 1
    fi

    # Resolve which manager to use
    if [ -n "$PREFERRED_MGR" ]; then
      case "$PREFERRED_MGR" in
        apt|snap|flatpak) ;;
        *)
          echo "Zyphor: ✖ Unsupported manager '$PREFERRED_MGR' (use apt, snap, or flatpak)"
          return 1
          ;;
      esac

      FOUND=0
      for m in "${FOUND_MGRS[@]}"; do
        [ "$m" = "$PREFERRED_MGR" ] && FOUND=1
      done
      if [ "$FOUND" -eq 0 ]; then
        echo "Zyphor: ✖ '$APP' is not installed via $PREFERRED_MGR"
        return 1
      fi

    elif [ "${#FOUND_MGRS[@]}" -eq 1 ]; then
      PREFERRED_MGR="${FOUND_MGRS[0]}"

    else
      echo "Zyphor: '$APP' was found installed via multiple managers:"
      i=1
      for m in "${FOUND_MGRS[@]}"; do
        case "$m" in
          apt)     echo "  $i) apt     → $APT_MATCH" ;;
          snap)    echo "  $i) snap    → $SNAP_MATCH" ;;
          flatpak) echo "  $i) flatpak → $FLATPAK_MATCH" ;;
        esac
        i=$((i + 1))
      done
      echo "  $i) cancel"
      read -rp "Zyphor: Choose [1-$i]: " CHOICE

      if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "${#FOUND_MGRS[@]}" ]; then
        echo "Zyphor: ✖ Cancelled"
        return 1
      fi
      PREFERRED_MGR="${FOUND_MGRS[$((CHOICE - 1))]}"
    fi

    case "$PREFERRED_MGR" in
      apt)     TARGET="$APT_MATCH" ;;
      snap)    TARGET="$SNAP_MATCH" ;;
      flatpak) TARGET="$FLATPAK_MATCH" ;;
    esac

    echo ""
    echo "Zyphor: You are about to remove (unregistered):"
    echo "  App   : $APP"
    echo "  Via   : $PREFERRED_MGR"
    echo "  Target: $TARGET"
    echo ""

    read -p "Continue? [y/N]: " CONFIRM
    case "$CONFIRM" in
      y|Y) ;;
      *)
        echo "Zyphor: Cancelled."
        echo ""
        return 0
        ;;
    esac

    echo ""
    echo "Zyphor: Removing '$TARGET' via $PREFERRED_MGR (unregistered)..."
    echo ""

    case "$PREFERRED_MGR" in

      apt)
        apt remove -y "$TARGET"
        MGR_EXIT=$?
        ;;

      snap)
        snap remove "$TARGET"
        MGR_EXIT=$?
        ;;

      flatpak)
        flatpak uninstall -y --noninteractive "$TARGET"
        MGR_EXIT=$?

        SHIM_PATH="/usr/local/bin/${APP}"
        if [ -f "$SHIM_PATH" ]; then
          echo "Zyphor: Removing CLI shim → $SHIM_PATH"
          rm -f "$SHIM_PATH"
        fi
        ;;
    esac

    if [ "$MGR_EXIT" -eq 0 ]; then
      echo ""
      echo "Zyphor: ✔ Removed '$TARGET' via $PREFERRED_MGR (unregistered)"
    else
      echo ""
      echo "Zyphor: ✖ Failed removing '$TARGET' via $PREFERRED_MGR"
      echo ""
      return 1
    fi

    echo ""
    read -p "Zyphor: Run autoremove (cleanup dependencies)? [y/N]: " AUTO
    if [[ "$AUTO" =~ ^[yY]$ ]]; then
      apt autoremove -y
      echo "Zyphor: ✔ Cleanup complete"
    fi

    echo ""
    echo "Zyphor: ✔ Successfully processed removal of '$APP'"
    echo ""
    return 0
  fi

  # ==================================================
  # SAFETY CONFIRMATION (REGISTERED APP)
  # ==================================================
  echo ""
  echo "Zyphor: You are about to remove:"
  echo "  App   : $APP"
  echo "  Type  : $TYPE"

  if [ -n "$PACKAGE" ]; then
    echo "  Target: $PACKAGE"
  fi

  echo ""

  read -p "Continue? [y/N]: " CONFIRM
  case "$CONFIRM" in
    y|Y) ;;
    *)
      echo "Zyphor: Cancelled."
      echo ""
      return 0
      ;;
  esac

  # ==================================================
  # REMOVE ENGINE
  # ==================================================
  echo ""
  echo "Zyphor: Removing '$APP'..."
  echo ""

  case "$TYPE" in

    # --------------------------
    # APT + DEB (UNIFIED + FALLBACK DETECTION)
    # --------------------------
    apt|deb)

      # fallback if package missing
      if [ -z "$PACKAGE" ]; then
        echo "Zyphor: ⚠ No package defined, attempting detection..."

        PACKAGE=$(dpkg -l | awk '{print $2}' | grep -i "^$APP" | head -n 1)

        # second fallback (looser match)
        if [ -z "$PACKAGE" ]; then
          PACKAGE=$(dpkg -l | awk '{print $2}' | grep -i "$APP" | head -n 1)
        fi

        if [ -z "$PACKAGE" ]; then
          echo "Zyphor: ✖ Could not determine package name"
          return 1
        fi

        echo "Zyphor: Using detected package → $PACKAGE"
      fi

      echo "Zyphor: Removing package → $PACKAGE"

      if dpkg -s "$PACKAGE" >/dev/null 2>&1; then
        apt remove -y "$PACKAGE"
      else
        echo "Zyphor: ⚠ Package not installed → $PACKAGE"
      fi
      ;;

    # --------------------------
    # SNAP
    # --------------------------
    snap)

      if [ -z "$PACKAGE" ]; then
        echo "Zyphor: ✖ Missing snap package"
        return 1
      fi

      echo "Zyphor: Removing Snap → $PACKAGE"

      if snap list 2>/dev/null | awk '{print $1}' | grep -qx "$PACKAGE"; then
        snap remove "$PACKAGE"
      else
        echo "Zyphor: ⚠ Snap not installed → $PACKAGE"
      fi
      ;;

    # --------------------------
    # FLATPAK
    # --------------------------
    flatpak)

      if [ -z "$PACKAGE" ]; then
        echo "Zyphor: ✖ Missing flatpak package (app ID)"
        return 1
      fi

      if ! command -v flatpak >/dev/null 2>&1; then
        echo "Zyphor: ✖ flatpak is not installed on this system"
        return 1
      fi

      echo "Zyphor: Removing Flatpak → $PACKAGE"

      if flatpak list --app --columns=application 2>/dev/null | grep -qx "$PACKAGE"; then
        flatpak uninstall -y --noninteractive "$PACKAGE"
      else
        echo "Zyphor: ⚠ Flatpak not installed → $PACKAGE"
      fi

      # ----- REMOVE CLI SHIM IF PRESENT -----
      SHIM_PATH="/usr/local/bin/${APP}"
      if [ -f "$SHIM_PATH" ]; then
        echo "Zyphor: Removing CLI shim → $SHIM_PATH"
        rm -f "$SHIM_PATH"
      fi
      ;;

    # --------------------------
    # INTERNAL MODULE
    # --------------------------
    internal)

      if [ -z "$MODULE" ]; then
        echo "Zyphor: ✖ Missing module"
        return 1
      fi

      echo "Zyphor: Removing internal module → $MODULE"
      bash "/usr/lib/zyphor/modules/$MODULE/remove.sh"
      ;;

    # --------------------------
    # UNKNOWN TYPE
    # --------------------------
    *)
      echo "Zyphor: ✖ Unknown type → $TYPE"
      return 1
      ;;
  esac

  # ==================================================
  # OPTIONAL CLEANUP
  # ==================================================
  echo ""
  read -p "Zyphor: Run autoremove (cleanup dependencies)? [y/N]: " AUTO

  if [[ "$AUTO" =~ ^[yY]$ ]]; then
    apt autoremove -y
    echo "Zyphor: ✔ Cleanup complete"
  fi

  echo ""
  echo "Zyphor: ✔ Successfully processed removal of '$APP'"
  echo ""
}